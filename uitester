import math
import struct
import wave
import os

OUT_DIR = "/home/claude/project/audio/sfx"
os.makedirs(OUT_DIR, exist_ok=True)
RATE = 44100


def envelope(i, n, attack, release):
    if i < attack:
        return i / attack
    if i > n - release:
        return max(0.0, (n - i) / release)
    return 1.0


def make_tone(path, freq_start, freq_end, duration, volume=0.25):
    n = int(RATE * duration)
    attack = int(n * 0.08)
    release = int(n * 0.5)
    frames = bytearray()
    for i in range(n):
        t = i / RATE
        freq = freq_start + (freq_end - freq_start) * (i / n)
        sample = math.sin(2 * math.pi * freq * t)
        sample += 0.25 * math.sin(2 * math.pi * freq * 2 * t)
        env = envelope(i, n, attack, release)
        val = int(max(-1.0, min(1.0, sample * env * volume)) * 32767)
        frames += struct.pack('<h', val)
    with wave.open(path, 'w') as f:
        f.setnchannels(1)
        f.setsampwidth(2)
        f.setframerate(RATE)
        f.writeframes(bytes(frames))
    print(f"Saved {path} ({duration}s)")


make_tone(f"{OUT_DIR}/hover.wav", freq_start=520, freq_end=760, duration=0.07, volume=0.18)
make_tone(f"{OUT_DIR}/click.wav", freq_start=380, freq_end=180, duration=0.11, volume=0.28)

